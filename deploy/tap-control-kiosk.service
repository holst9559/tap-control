[Unit]
Description=Tap Control Chromium kiosk
After=graphical.target tap-control.service
Wants=tap-control.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium-browser --kiosk --noerrdialogs --disable-infobars --check-for-update-interval=31536000 http://localhost:3000/
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
