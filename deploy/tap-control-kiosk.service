[Unit]
Description=Tap Control Epiphany kiosk
After=graphical.target tap-control.service
Wants=tap-control.service

[Service]
Type=simple
User=antonholst
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/antonholst/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/antonholst
ExecStart=/home/antonholst/tap-control/deploy/start-kiosk.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
